<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>AOSix</RootNamespace>
    <AssemblyName>AOSix</AssemblyName>
    <Nullable>disable</Nullable>
    <Authors>matsix</Authors>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Assets/ holds the shaders (source for the `aosix` AssetBundle), not C# to compile. -->
  <ItemGroup>
    <Compile Remove="Assets\**\*.cs" />
  </ItemGroup>

  <!-- References resolve from libs/ (SPT 4.1 game Managed + BepInEx, same set as SSRSix). -->
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>libs\0Harmony.dll</HintPath></Reference>
    <Reference Include="spt-reflection"><HintPath>libs\spt-reflection.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>libs\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>libs\BepInEx.dll</HintPath></Reference>
    <Reference Include="Comfort"><HintPath>libs\Comfort.dll</HintPath></Reference>
    <Reference Include="Comfort.Unity"><HintPath>libs\Comfort.Unity.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>libs\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>libs\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>libs\UnityEngine.AssetBundleModule.dll</HintPath></Reference>
  </ItemGroup>

  <!-- Auto-deploy every build into the live install (skipped if the folder doesn't exist). The shader bundle
       goes to plugins\AOSix\Assets\aosix. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('F:\SPT4.1\BepInEx\plugins\AOSix')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="F:\SPT4.1\BepInEx\plugins\AOSix" />
    <Message Importance="high" Text="==&gt; AOSix.dll deployed to F:\SPT4.1\BepInEx\plugins\AOSix" />
  </Target>

</Project>
